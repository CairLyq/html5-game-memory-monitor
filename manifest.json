{
  "manifest_version": 3,
  "name": "HTML5 游戏内存监测",
  "version": "1.7.1",
  "description": "监测 HTML5 游戏（Phaser / PixiJS / Three.js / Babylon.js / Cocos / LayaAir 等）的 JS 堆内存、WebGL 纹理/缓冲区/着色器/渲染缓冲资源、FPS 与绘制调用；支持逐份纹理来源追踪。仅在用户指定的网站或点击扩展时启用。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HTML5 游戏内存监测",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["scripting", "storage"],
  "optional_host_permissions": ["*://*/*", "file:///*"]
}

{
  "manifest_version": 3,
  "name": "HTML5 游戏内存监测",
  "version": "1.8.0",
  "description": "监测 HTML5 游戏的 JS 堆内存、WebGL 纹理显存、FPS 与绘制调用，自动识别 Phaser / PixiJS / Three.js / LayaAir 等游戏引擎。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HTML5 游戏内存监测",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
